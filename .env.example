# Variáveis de ambiente — copie para .env.local e preencha.
# Use APENAS um projeto Supabase criado para este case.
# Nunca use credenciais pessoais ou de outros projetos.

# Supabase — painel do projeto > Settings > API
# A chave publicável (sb_publishable_...) substitui a legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Usada somente em rotas de servidor (funções SECURITY DEFINER de aprovação
# e admin de usuários) e em scripts locais de importação. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Base de dados (importação): URI de connection pooling do projeto
# (host .pooler.supabase.com) OU apenas a senha do banco (DB_PASSWORD).
# Apenas se for reimportar a planilha por fora das migrations.
DATABASE_URL=
DB_PASSWORD=

# E-mail (D — notificação proativa) via Resend
# Crie uma chave em https://resend.com/api-keys
RESEND_API_KEY=
# Remetente (precisa de domínio verificado no Resend; onboarding@resend.dev só
# envia para o e-mail da própria conta Resend).
EMAIL_FROM=PlanHub <onboarding@resend.dev>
# Destinatário interno dos avisos de decisão do cliente. Enquanto o provedor
# estiver em modo de teste (sem domínio verificado), use o e-mail da própria
# conta Resend: é o único que ele entrega.
EMAIL_EQUIPE=ops@planhub.case