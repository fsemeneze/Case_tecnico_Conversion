# Variáveis de ambiente — copie para .env.local e preencha.
# Use APENAS um projeto Supabase criado para este case.
# Nunca use credenciais pessoais ou de outros projetos.

# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada somente em scripts locais de migração/seed. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Base de dados direta (migrations e importação)
DATABASE_URL=

# Segredo para assinar os links de aprovação do cliente
APPROVAL_TOKEN_SECRET=
